# Автоматически определять текстовые файлы
* text=auto

# Явно указать LF для файлов, которые должны быть с LF в репозитории
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
Dockerfile text eol=lf

# Файлы, которые Git не должен трогать
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.gltf binary
*.glb  binary
*.zip  binary
*.woff binary
*.woff2 binary